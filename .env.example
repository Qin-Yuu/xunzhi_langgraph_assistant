# OpenAI-compatible service. Use a model that supports tool calling.
MODEL=openai/your-model-id
OPENAI_API_KEY=
OPENAI_API_BASE=https://your-provider.example/v1
TAVILY_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=react-agent

# Optional alternative: set MODEL=anthropic/<model-id> and provide this key.
# ANTHROPIC_API_KEY=
